# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=your_preferred_openrouter_model
QDRANT_URL=http://localhost:6333
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/underwriter
EMBEDDING_MODEL=BAAI/bge-m3

# Optional
# RERANKER_MODEL=BAAI/bge-reranker-base      # or BAAI/bge-reranker-v2-m3 (slower, more accurate)
# RERANKER_ENABLED=true
# TABLE_ENGINE=pdfplumber                    # or docling
# OCR_ENABLED=true
# For a local run without Docker, leave QDRANT_URL/DATABASE_URL unset: embedded Qdrant + SQLite under data/.
